# WebsMagic — Backend Environment Configuration

# Server & Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/websmagic?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/websmagic

# Client Origin (CORS Whitelist, comma-separated for multiple origins)
# Example Production: https://web-sma-gic.vercel.app
CLIENT_URL=http://localhost:5173

# Session & JWT Cryptographic Secret (32+ character random string in production)
SESSION_SECRET=change-this-to-a-super-secure-random-32-character-secret

# Cookie SameSite Policy
# Use 'none' for cross-domain deployments (e.g. Vercel frontend + Render backend)
# Use 'lax' if frontend and backend share the apex domain (e.g. app.domain.com and api.domain.com)
COOKIE_SAMESITE=lax

# Founder 1 Provisioning Credentials (Govind Rathod)
FOUNDER_1_NAME=Govind Rathod
FOUNDER_1_EMAIL=hello.websmagic@gmail.com
FOUNDER_1_PASSWORD=FounderGovind#2026

# Founder 2 Provisioning Credentials (Business Partner)
FOUNDER_2_NAME=Co-founder (Business Development)
FOUNDER_2_EMAIL=partner@websmagic.com
FOUNDER_2_PASSWORD=FounderPartner#2026
